{"file": "1-Perustaso/Linnasmaki-Askelia-2/5_Automaattinen_vastaaja.mp3", "duration": 97.5, "segments": [{"start": 4.98, "end": 8.06, "text": "Tervetuloa DNA-asiakaspalveluun.", "words": [{"w": "Tervetuloa", "s": 4.98, "e": 6.38}, {"w": "DNA", "s": 6.38, "e": 6.72}, {"w": "-asiakaspalveluun.", "s": 6.72, "e": 8.06}]}, {"start": 9.35, "end": 13.49, "text": "Jos haluat palvelua suomeksi, valitse 1.", "words": [{"w": "Jos", "s": 9.35, "e": 10.71}, {"w": "haluat", "s": 10.71, "e": 11.11}, {"w": "palvelua", "s": 11.11, "e": 11.61}, {"w": "suomeksi,", "s": 11.61, "e": 12.27}, {"w": "valitse", "s": 12.51, "e": 13.19}, {"w": "1.", "s": 13.19, "e": 13.49}]}, {"start": 15.05, "end": 18.65, "text": "Mikäli asiasi koskee matkapuhelin asioita, valitse 1.", "words": [{"w": "Mikäli", "s": 14.81, "e": 15.49}, {"w": "asiasi", "s": 15.49, "e": 15.89}, {"w": "koskee", "s": 15.89, "e": 16.21}, {"w": "matkapuhelin", "s": 16.21, "e": 16.85}, {"w": "asioita,", "s": 16.85, "e": 17.41}, {"w": "valitse", "s": 17.65, "e": 18.33}, {"w": "1.", "s": 18.33, "e": 18.65}]}, {"start": 19.33, "end": 21.49, "text": "TV-palveluita 2.", "words": [{"w": "TV", "s": 19.33, "e": 19.95}, {"w": "-palveluita", "s": 19.95, "e": 20.77}, {"w": "2.", "s": 20.77, "e": 21.49}]}, {"start": 22.49, "end": 25.43, "text": "Kotipuhelinta tai luuriliittymää 3.", "words": [{"w": "Kotipuhelinta", "s": 22.49, "e": 23.43}, {"w": "tai", "s": 23.43, "e": 23.61}, {"w": "luuriliittymää", "s": 23.61, "e": 24.57}, {"w": "3.", "s": 24.57, "e": 25.43}]}, {"start": 26.49, "end": 28.67, "text": "Laajakaistapalveluita 4.", "words": [{"w": "Laajakaistapalveluita", "s": 26.49, "e": 27.85}, {"w": "4.", "s": 27.85, "e": 28.67}]}, {"start": 31.94, "end": 35.92, "text": "Jos tarvitset puhelimeesi PUC-koodin, valitse 1.", "words": [{"w": "Jos", "s": 31.94, "e": 32.78}, {"w": "tarvitset", "s": 32.78, "e": 33.44}, {"w": "puhelimeesi", "s": 33.44, "e": 34.12}, {"w": "PUC", "s": 34.12, "e": 34.46}, {"w": "-koodin,", "s": 34.46, "e": 34.92}, {"w": "valitse", "s": 35.12, "e": 35.66}, {"w": "1.", "s": 35.66, "e": 35.92}]}, {"start": 36.38, "end": 43.02, "text": "Jos SIM-korttisi on kadonnut tai varastettu tai jos haluat sulkea mobiilivarmenteen, valitse 2.", "words": [{"w": "Jos", "s": 36.38, "e": 37.18}, {"w": "SIM", "s": 37.18, "e": 37.44}, {"w": "-korttisi", "s": 37.44, "e": 37.92}, {"w": "on", "s": 37.92, "e": 38.06}, {"w": "kadonnut", "s": 38.06, "e": 38.56}, {"w": "tai", "s": 38.56, "e": 38.8}, {"w": "varastettu", "s": 38.8, "e": 39.54}, {"w": "tai", "s": 39.54, "e": 39.98}, {"w": "jos", "s": 39.98, "e": 40.2}, {"w": "haluat", "s": 40.2, "e": 40.5}, {"w": "sulkea", "s": 40.5, "e": 40.86}, {"w": "mobiilivarmenteen,", "s": 40.86, "e": 41.94}, {"w": "valitse", "s": 42.14, "e": 42.72}, {"w": "2.", "s": 42.72, "e": 43.02}]}, {"start": 44.18, "end": 50.42, "text": "Mikäli asiasi koskee DNA-äly, DNA-rajaton tai DNA-web-liittymiä, valitse 3.", "words": [{"w": "Mikäli", "s": 44.18, "e": 44.62}, {"w": "asiasi", "s": 44.62, "e": 45.12}, {"w": "koskee", "s": 45.12, "e": 45.44}, {"w": "DNA", "s": 45.44, "e": 45.86}, {"w": "-äly,", "s": 45.86, "e": 46.26}, {"w": "DNA", "s": 46.5, "e": 46.9}, {"w": "-rajaton", "s": 46.9, "e": 47.5}, {"w": "tai", "s": 47.5, "e": 47.82}, {"w": "DNA", "s": 47.82, "e": 48.28}, {"w": "-web", "s": 48.28, "e": 48.64}, {"w": "-liittymiä,", "s": 48.64, "e": 49.34}, {"w": "valitse", "s": 49.52, "e": 50.08}, {"w": "3.", "s": 50.08, "e": 50.42}]}, {"start": 51.18, "end": 57.18, "text": "Jos haluat tehdä häiriöilmoituksen tai ilmoittaa kuuluvuusongelmasta, valitse 4.", "words": [{"w": "Jos", "s": 51.18, "e": 52.0}, {"w": "haluat", "s": 52.0, "e": 52.32}, {"w": "tehdä", "s": 52.32, "e": 52.62}, {"w": "häiriöilmoituksen", "s": 52.62, "e": 53.84}, {"w": "tai", "s": 53.84, "e": 54.26}, {"w": "ilmoittaa", "s": 54.26, "e": 54.82}, {"w": "kuuluvuusongelmasta,", "s": 54.82, "e": 56.08}, {"w": "valitse", "s": 56.5, "e": 56.88}, {"w": "4.", "s": 56.88, "e": 57.18}]}, {"start": 57.18, "end": 62.24, "text": "Muissa asioissa odota hetki. Puhelusi yhdistyy asiakaspalveluun.", "words": [{"w": "Muissa", "s": 57.18, "e": 58.12}, {"w": "asioissa", "s": 58.12, "e": 58.76}, {"w": "odota", "s": 58.76, "e": 59.38}, {"w": "hetki.", "s": 59.38, "e": 59.84}, {"w": "Puhelusi", "s": 60.04, "e": 60.6}, {"w": "yhdistyy", "s": 60.6, "e": 61.1}, {"w": "asiakaspalveluun.", "s": 61.1, "e": 62.24}]}, {"start": 69.7, "end": 77.04, "text": "Jos asiasi koskee äly, web tai rajaton liittymän aktivointia, valitse nyt yksi.", "words": [{"w": "Jos", "s": 69.7, "e": 70.76}, {"w": "asiasi", "s": 70.76, "e": 71.24}, {"w": "koskee", "s": 71.24, "e": 71.62}, {"w": "äly,", "s": 71.62, "e": 72.02}, {"w": "web", "s": 72.42, "e": 72.94}, {"w": "tai", "s": 72.94, "e": 73.52}, {"w": "rajaton", "s": 73.52, "e": 74.06}, {"w": "liittymän", "s": 74.06, "e": 74.52}, {"w": "aktivointia,", "s": 74.52, "e": 75.28}, {"w": "valitse", "s": 75.52, "e": 76.24}, {"w": "nyt", "s": 76.24, "e": 76.46}, {"w": "yksi.", "s": 76.46, "e": 77.04}]}, {"start": 77.82, "end": 82.28, "text": "Muussa tapauksessa odota hetki, niin yhdistämme sinut asiakaspalveluun.", "words": [{"w": "Muussa", "s": 77.82, "e": 78.56}, {"w": "tapauksessa", "s": 78.56, "e": 79.22}, {"w": "odota", "s": 79.22, "e": 79.6}, {"w": "hetki,", "s": 79.6, "e": 80.06}, {"w": "niin", "s": 80.26, "e": 80.36}, {"w": "yhdistämme", "s": 80.36, "e": 80.96}, {"w": "sinut", "s": 80.96, "e": 81.2}, {"w": "asiakaspalveluun.", "s": 81.2, "e": 82.28}]}, {"start": 92.82, "end": 95.36, "text": "Vastaamme puheluoti. Mahdollisimmun pian.", "words": [{"w": "Vastaamme", "s": 92.82, "e": 93.74}, {"w": "puheluoti.", "s": 93.74, "e": 94.32}, {"w": "Mahdollisimmun", "s": 94.36, "e": 95.1}, {"w": "pian.", "s": 95.1, "e": 95.36}]}]}